NEXT_PUBLIC_GITHUB_ORG=CommunityPro
NEXT_PUBLIC_PRACTICE_REPO=Practice-Contribution
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
REVALIDATE_SECRET=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
